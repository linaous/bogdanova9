def createSpiral(n):
    if type(n) is not int or n<1:
        return []
    m = [[0]*n for i in range(n)]
    
    v = 1
    t,b =0,n-1
    l,r = 0,n-1
    
    while v<=n*n:
        for i in range(l,r+1):
            m[t][i]=v
            v+=1
        t+=1
        
        for i in range(t,b+1):
            m[i][r]=v
            v+=1
        r-=1
        
        if t<=b:
            for i in range(r,l-1,-1):
                m[b][i]=v
                v+=1
            b-=1
            
        if l<=r:
            for i in range(b,t-1,-1):
                m[i][l]=v
                v+=1
            l+=1
            
    return m
